.aider*
.env
build/
dist/
.vscode
.DS_Store
.dev/

# Personal autogen control file (machine paths + private model catalog).
# Ship quartermaster-generate.example.yaml as the template instead.
quartermaster-generate.yaml

# UI build output; placeholder.txt is kept so the go:embed succeeds.
internal/server/ui_dist/*

# Same, for the first-run wizard's own bundle (ui-svelte/vite.setup.config.ts).
# .gitkeep is NOT ignored: `//go:embed all:ui_dist` in internal/setup needs at
# least one file present or the package will not compile on a fresh clone.
internal/setup/ui_dist/*
!internal/setup/ui_dist/.gitkeep

# Release build output. packaging/windows/build-release.ps1 wipes and regenerates
# staging/ on every run, and iscc writes the installer into Output/ — both are
# pure build products (they were tracked by accident and cost ~52MB of history).
staging/
Output/

# JS deps + tool caches.
node_modules/
__pycache__/

# Public site build (ui-svelte/site/build.mjs). Deployed straight to GitHub
# Pages by .github/workflows/pages.yml — generated HTML has no reader inside the
# repo, so committing it would only give it a way to go stale.
.site/

# UI screenshot captures (ui-svelte/scripts/shots.mjs). Local visual-review
# artifacts for before/after diffing — regenerated on demand, never shipped.
ui-svelte/.shots/

# Vendored title model: fetched on first use / by the installer, not tracked.
# See internal/server/assets/README.md and titlegen_asset.go.
internal/server/assets/*.gguf
