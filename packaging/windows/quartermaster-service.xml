<!--
  WinSW service definition for quartermaster.

  WinSW wraps a non-service-aware exe as a real Windows service (the proxy has no
  SCM handler, so `sc create` directly would be killed for "not responding").

  Install:
    1. Download WinSW: https://github.com/winsw/winsw/releases (WinSW-x64.exe)
    2. Rename it to  quartermaster-service.exe  and place it next to THIS
       xml file and the proxy binary.
    3. From an elevated prompt in that folder:
         .\quartermaster-service.exe install
         .\quartermaster-service.exe start
    Uninstall:  .\quartermaster-service.exe stop ; .\quartermaster-service.exe uninstall

  %BASE% expands to the folder holding the service exe. Adjust <arguments> ports
  and paths to your layout. Drop -generate to load a static -config instead.
-->
<service>
  <id>quartermaster</id>
  <name>quartermaster</name>
  <description>quartermaster fork — model proxy with startup config autogen.</description>

  <executable>%BASE%\quartermaster-windows-amd64.exe</executable>
  <arguments>-config "%BASE%\config.yaml" -generate "%BASE%\quartermaster-generate.yaml" -listen 0.0.0.0:1250 -watch-config</arguments>
  <workingdirectory>%BASE%</workingdirectory>

  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="5 sec"/>

  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
</service>
