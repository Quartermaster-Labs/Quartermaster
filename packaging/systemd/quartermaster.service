[Unit]
Description=quartermaster — all-in-one local inference engine with startup config autogen
Documentation=https://github.com/Quartermaster-Labs/Quartermaster
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Run as a dedicated unprivileged user (create with: useradd --system --no-create-home llama)
User=llama
Group=llama
WorkingDirectory=/opt/quartermaster

# Edit paths/ports to match the install. -generate makes the proxy build its
# config from the local GGUF tree on startup (hash-gated, so an unchanged models
# folder skips the scan). Drop -generate to load a static -config instead.
ExecStart=/opt/quartermaster/quartermaster \
  -config /etc/quartermaster/config.yaml \
  -generate /etc/quartermaster/quartermaster-generate.yaml \
  -listen 0.0.0.0:1250 \
  -watch-config

# The in-app updater already detects systemd (INVOCATION_ID is set in every unit
# it starts), so it stages the new binary and leaves the restart to you rather
# than bouncing a service nobody asked it to bounce. Finish a staged update with
# `systemctl restart quartermaster`. This var is belt-and-braces, and the way to
# get the same behaviour under any other supervisor.
Environment=QM_SUPERVISED=1

# The swap renames the binary in WorkingDirectory, so that path must stay in
# ReadWritePaths below or the updater reports the install as read-only.

# Autogen scans every GGUF header on first start (tens of seconds for a large
# models folder); keep the start timeout generous.
TimeoutStartSec=180
Restart=on-failure
RestartSec=5

# Hardening — relax if the models/config live outside the paths below.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/etc/quartermaster /opt/quartermaster

[Install]
WantedBy=multi-user.target
