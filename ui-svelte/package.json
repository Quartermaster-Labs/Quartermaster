{
  "name": "ui-svelte",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "vite build --emptyOutDir && node scripts/compress-assets.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "shots": "node scripts/shots.mjs",
    "build:setup": "vite build --config vite.setup.config.ts",
    "docs": "node scripts/wiki-docs.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.8",
    "@tsconfig/svelte": "^5.0.4",
    "@types/hast": "^3.0.4",
    "@types/node": "^25.1.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "svelte": "^5.46.4",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.8.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "chart.js": "4.5.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.28",
    "lucide-svelte": "^0.563.0",
    "mermaid": "^11.16.1",
    "pdfjs-dist": "^6.2.108",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "svelte-spa-router": "^4.0.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  }
